gitignore
# =========================================================================
# Compiled Java & Logs
# =========================================================================
*.class
*.log
*.ctxt
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# =========================================================================
# Maven Specific
# =========================================================================
# Ignore the build output directory
target/

# Maven release plugin files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Maven wrapper extensions
.mvn/timing.properties
.mvn/wrapper/.maven-wrapper/

# EXCEPTION: Do NOT ignore the Maven Wrapper jar/properties (allows team execution without Maven installed)
! .mvn/wrapper/maven-wrapper.jar
! .mvn/wrapper/maven-wrapper.properties

# =========================================================================
# IDEs & Editors (IntelliJ, Eclipse, VS Code)
# =========================================================================
.idea/
*.iws
*.iml
*.ipr
out/
.metadata/
.classpath
.project
.settings/
.factorypath
.vscode/
*.code-workspace

# =========================================================================
# OS Generated Files
# =========================================================================
.DS_Store
Thumbs.db
desktop.ini